# Publish only the reader-facing collection. All maintenance files stay local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/RESOURCES.md
!/RESOURCES.en.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE.md
!/assets/
